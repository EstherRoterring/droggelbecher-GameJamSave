.header {
    font-size: 150px;
    color: rgb(0, 0, 0);
    -unity-font: url("project://database/Assets/MenuAssets/NicoMoji-Regular.ttf?fileID=12800000&guid=9585211f0b0ee4f178bcafd15c7fb3d7&type=3#NicoMoji-Regular");
    -unity-font-style: normal;
}

.button {
    font-size: 70px;
    border-top-left-radius: 50px;
    border-top-right-radius: 50px;
    border-bottom-right-radius: 50px;
    border-bottom-left-radius: 50px;
    background-color: rgb(255, 255, 255);
    width: 400px;
    height: 80px;
    align-self: center;
    margin-top: 30px;
    margin-right: 30px;
    margin-bottom: 30px;
    margin-left: 30px;
    -unity-font-style: normal;
    -unity-font: url("project://database/Assets/MenuAssets/NicoMoji-Regular.ttf?fileID=12800000&guid=9585211f0b0ee4f178bcafd15c7fb3d7&type=3#NicoMoji-Regular");
    color: rgb(0, 0, 0);
    -unity-font-definition: initial;
    -unity-text-outline-color: rgba(0, 0, 0, 0);
    border-left-color: rgb(206, 206, 206);
    border-right-color: rgb(206, 206, 206);
    border-top-color: rgb(206, 206, 206);
    border-bottom-color: rgb(206, 206, 206);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    align-items: stretch;
    -unity-text-align: middle-center;
}
